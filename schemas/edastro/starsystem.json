{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edastro.com/schemas/starsystem.json",
  "title": "EDAstroStarSystemResponse",
  "description": "Star system record returned by GET https://edastro.com/api/starsystem?q=...",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["ID", "name", "id64"],
    "properties": {
      "ID": { "type": "integer" },
      "id64": { "type": "integer" },
      "name": { "type": "string" },
      "FSSdate": { "type": ["string", "null"] },
      "FSSprogress": { "type": ["number", "null"] },
      "bodyCount": { "type": ["integer", "null"] },
      "nonbodyCount": { "type": ["integer", "null"] },
      "complete": { "type": ["boolean", "integer", "null"] },
      "coord_x": { "type": ["number", "null"] },
      "coord_y": { "type": ["number", "null"] },
      "coord_z": { "type": ["number", "null"] },
      "coordinates": {
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      },
      "date_added": { "type": ["string", "null"] },
      "edsm_date": { "type": ["string", "null"] },
      "edsm_id": { "type": ["integer", "null"] },
      "id64boxelID": { "type": ["integer", "null"] },
      "id64boxelnum": { "type": ["integer", "null"] },
      "id64mass": { "type": ["integer", "null"] },
      "id64sectorID": { "type": ["integer", "null"] },
      "mainStarID": { "type": ["integer", "null"] },
      "mainStarType": { "type": ["string", "null"] },
      "masscode": { "type": ["string", "null"] },
      "numAW": { "type": ["integer", "null"] },
      "numELW": { "type": ["integer", "null"] },
      "numTerra": { "type": ["integer", "null"] },
      "numWW": { "type": ["integer", "null"] },
      "region": { "type": ["string", "null"] },
      "sol_dist": { "type": ["number", "null"] },
      "updateTime": { "type": ["string", "null"] },
      "updated": { "type": ["integer", "null"] },
      "barycenters": { "type": "array", "items": { "type": "object" } },
      "carriers": { "type": "array", "items": { "type": "object" } },
      "codex": { "type": "array", "items": { "type": "object" } },
      "planets": { "type": "array", "items": { "type": "object" } },
      "stars": { "type": "array", "items": { "type": "object" } },
      "stations": { "type": "array", "items": { "type": "object" } }
    },
    "additionalProperties": true
  }
}
