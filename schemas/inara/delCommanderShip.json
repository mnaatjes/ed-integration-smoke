{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/delCommanderShip#",
  "title": "InaraDelCommanderShip",
  "description": "Deletes/sells a ship from the fleet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "delCommanderShip"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shipType": {
          "type": "string"
        },
        "shipGameID": {
          "type": "integer"
        }
      },
      "required": [
        "shipType",
        "shipGameID"
      ]
    }
  }
}
