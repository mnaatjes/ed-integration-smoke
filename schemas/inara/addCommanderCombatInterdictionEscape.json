{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/addCommanderCombatInterdictionEscape#",
  "title": "InaraAddCommanderCombatInterdictionEscape",
  "description": "Logs escaping an interdiction vector tether.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "addCommanderCombatInterdictionEscape"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starsystemName": {
          "type": "string"
        },
        "interdictorName": {
          "type": "string"
        }
      },
      "required": [
        "starsystemName",
        "interdictorName"
      ]
    }
  }
}
