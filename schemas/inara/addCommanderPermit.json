{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/addCommanderPermit#",
  "title": "InaraAddCommanderPermit",
  "description": "Records star system entry permit acquisition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "addCommanderPermit"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starsystemName": {
          "type": "string"
        }
      },
      "required": [
        "starsystemName"
      ]
    }
  }
}
