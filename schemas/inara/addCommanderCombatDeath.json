{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/addCommanderCombatDeath#",
  "title": "InaraAddCommanderCombatDeath",
  "description": "Logs player ship destruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "addCommanderCombatDeath"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starsystemName": {
          "type": "string"
        },
        "opponentName": {
          "type": "string"
        },
        "wingOpponentNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isPvP": {
          "type": "boolean"
        }
      },
      "required": [
        "starsystemName"
      ]
    }
  }
}
