{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/setCommanderStorageModules#",
  "title": "InaraSetCommanderStorageModules",
  "description": "Updates inventory of stored outfitting modules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "setCommanderStorageModules"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemName": {
                "type": "string"
              },
              "itemValue": {
                "type": "integer"
              },
              "itemHot": {
                "type": "boolean"
              },
              "starsystemName": {
                "type": "string"
              },
              "stationName": {
                "type": "string"
              },
              "marketID": {
                "type": "integer"
              },
              "storageSlot": {
                "type": "integer"
              },
              "inTransit": {
                "type": "boolean"
              }
            },
            "required": [
              "itemName"
            ]
          }
        }
      },
      "required": [
        "modules"
      ]
    }
  }
}
