{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/resetCommanderInventory#",
  "title": "InaraResetCommanderInventory",
  "description": "Resets inventory collections prior to clean synchronization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "resetCommanderInventory"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inventoryTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "materials",
              "cargo",
              "data",
              "components"
            ]
          }
        }
      },
      "required": []
    }
  }
}
