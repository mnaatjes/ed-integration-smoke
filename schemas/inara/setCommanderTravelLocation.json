{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inara.cz/schemas/events/setCommanderTravelLocation#",
  "title": "InaraSetCommanderTravelLocation",
  "description": "Updates commander's current star system and station.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventName",
    "eventTimestamp",
    "eventData"
  ],
  "properties": {
    "eventName": {
      "type": "string",
      "const": "setCommanderTravelLocation"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventCustomID": {
      "type": "integer"
    },
    "eventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starsystemName": {
          "type": "string"
        },
        "stationName": {
          "type": "string"
        },
        "marketID": {
          "type": "integer"
        },
        "bodyName": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "shipType": {
          "type": "string"
        },
        "shipGameID": {
          "type": "integer"
        },
        "isTaxiDropShip": {
          "type": "boolean"
        }
      },
      "required": [
        "starsystemName"
      ]
    }
  }
}
