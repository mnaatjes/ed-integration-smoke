{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/currentfactionstate#",
  "title": "SpanshCurrentFactionState",
  "description": "Current states for a faction.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "state": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          null,
          "Blight",
          "Boom",
          "Bust",
          "Civil Liberty",
          "Civil Unrest",
          "Civil War",
          "Drought",
          "Election",
          "Expansion",
          "Famine",
          "Infrastructure Failure",
          "Investment",
          "Lockdown",
          "Natural Disaster",
          "None",
          "Outbreak",
          "Pirate Attack",
          "Public Holiday",
          "Retreat",
          "Terrorist Attack",
          "War"
        ]
      },
      "trend": {
        "description": "Trend of the state of the faction.",
        "type": "number"
      }
    },
    "required": [
      "state"
    ],
    "additionalProperties": false
  }
}
