{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/ringsignals#",
  "title": "SpanshRingSignals",
  "description": "The signals that can be found within the belt or ring.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "description": "Type of the signal.",
        "type": "string",
        "enum": [
          "Alexandrite",
          "Serendibite",
          "Monazite",
          "Bromellite",
          "Low Temperature Diamonds",
          "Void Opal",
          "Grandidierite",
          "Benitoite",
          "Tritium",
          "Musgravite",
          "Rhodplumsite",
          "Painite",
          "Platinum",
          "Bauxite",
          "Liquid oxygen",
          "Hydrogen Peroxide",
          "Water",
          "Lepidolite",
          "Uraninite",
          "Cobalt",
          "Methane Clathrate",
          "Rutile",
          "Lithium Hydroxide",
          "Coltan",
          "Gallite",
          "Indite",
          "Methanol Monohydrate Crystals",
          "Praseodymium",
          "Samarium",
          "Bertrandite"
        ]
      },
      "count": {
        "description": "Number of instances of the signal.",
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "name",
      "count"
    ]
  }
}
