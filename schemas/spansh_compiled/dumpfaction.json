{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/dumpfaction#",
  "title": "SpanshDumpFaction",
  "description": "Spansh DumpFaction contract.",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the faction.",
      "type": "string"
    },
    "allegiance": {
      "description": "Allegiance of the faction.",
      "$ref": "#/components/schemas/Allegiance"
    },
    "government": {
      "description": "Government type of the faction.",
      "$ref": "#/components/schemas/Government"
    },
    "systems": {
      "description": "Systems which the faction has a presence in.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "systemName": {
            "description": "Name of the system the faction is present in.",
            "type": "string"
          },
          "systemId64": {
            "description": "The ID64 of the system the faction is present in.",
            "type": "integer",
            "minimum": 0
          },
          "isControllingFaction": {
            "description": "Does the faction controls the system?",
            "type": "boolean"
          },
          "coords": {
            "description": "Coordinates of the system.",
            "type": "object",
            "properties": {
              "x": {
                "description": "X coordinate of the system.",
                "type": "number"
              },
              "y": {
                "description": "Y coordinate of the system.",
                "type": "number"
              },
              "z": {
                "description": "Z coordinate of the system.",
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "systemName",
          "systemId64",
          "coords"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "systems"
  ]
}
