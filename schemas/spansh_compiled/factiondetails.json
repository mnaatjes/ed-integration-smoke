{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/factiondetails#",
  "title": "SpanshFactionDetails",
  "description": "Full faction state",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the faction of the system.",
      "type": "string"
    },
    "state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Blight",
        "Boom",
        "Bust",
        "Civil Liberty",
        "Civil Unrest",
        "Civil War",
        "Drought",
        "Election",
        "Expansion",
        "Famine",
        "Infrastructure Failure",
        "Investment",
        "Lockdown",
        "Natural Disaster",
        "None",
        "Outbreak",
        "Pirate Attack",
        "Public Holiday",
        "Retreat",
        "Terrorist Attack",
        "War"
      ]
    },
    "allegiance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Alliance",
        "Empire",
        "Federation",
        "Frontline Solutions",
        "Guardian",
        "Independent",
        "Pilots Federation",
        "Thargoid"
      ]
    },
    "government": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Anarchy",
        "Communism",
        "Confederacy",
        "Cooperative",
        "Corporate",
        "Democracy",
        "Dictatorship",
        "Engineer",
        "Feudal",
        "Megaconstruction",
        "None",
        "Patronage",
        "Prison",
        "Prison Colony",
        "Private Ownership",
        "Theocracy"
      ]
    },
    "influence": {
      "description": "Influence of the faction.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "activeStates": {
      "description": "Current states for a faction.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "Blight",
              "Boom",
              "Bust",
              "Civil Liberty",
              "Civil Unrest",
              "Civil War",
              "Drought",
              "Election",
              "Expansion",
              "Famine",
              "Infrastructure Failure",
              "Investment",
              "Lockdown",
              "Natural Disaster",
              "None",
              "Outbreak",
              "Pirate Attack",
              "Public Holiday",
              "Retreat",
              "Terrorist Attack",
              "War"
            ]
          },
          "trend": {
            "description": "Trend of the state of the faction.",
            "type": "number"
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      }
    },
    "pendingStates": {
      "description": "Current states for a faction.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "Blight",
              "Boom",
              "Bust",
              "Civil Liberty",
              "Civil Unrest",
              "Civil War",
              "Drought",
              "Election",
              "Expansion",
              "Famine",
              "Infrastructure Failure",
              "Investment",
              "Lockdown",
              "Natural Disaster",
              "None",
              "Outbreak",
              "Pirate Attack",
              "Public Holiday",
              "Retreat",
              "Terrorist Attack",
              "War"
            ]
          },
          "trend": {
            "description": "Trend of the state of the faction.",
            "type": "number"
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      }
    },
    "recoveringStates": {
      "description": "Current states for a faction.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "Blight",
              "Boom",
              "Bust",
              "Civil Liberty",
              "Civil Unrest",
              "Civil War",
              "Drought",
              "Election",
              "Expansion",
              "Famine",
              "Infrastructure Failure",
              "Investment",
              "Lockdown",
              "Natural Disaster",
              "None",
              "Outbreak",
              "Pirate Attack",
              "Public Holiday",
              "Retreat",
              "Terrorist Attack",
              "War"
            ]
          },
          "trend": {
            "description": "Trend of the state of the faction.",
            "type": "number"
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name"
  ]
}
