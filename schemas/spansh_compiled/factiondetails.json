{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/factiondetails#",
  "title": "SpanshFactionDetails",
  "description": "Full faction state",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the faction of the system.",
      "type": "string"
    },
    "state": {
      "description": "State of the faction of the system.",
      "$ref": "#/components/schemas/FactionState"
    },
    "allegiance": {
      "description": "Allegiance of the faction of the system.",
      "$ref": "#/components/schemas/Allegiance"
    },
    "government": {
      "description": "Government type of the faction of the system.",
      "$ref": "#/components/schemas/Government"
    },
    "influence": {
      "$ref": "#/components/schemas/Influence"
    },
    "activeStates": {
      "description": "Currently active states for this faction.",
      "$ref": "#/components/schemas/CurrentFactionState"
    },
    "pendingStates": {
      "description": "Pending states for this faction.",
      "$ref": "#/components/schemas/CurrentFactionState"
    },
    "recoveringStates": {
      "description": "Recovering states for this faction.",
      "$ref": "#/components/schemas/CurrentFactionState"
    }
  },
  "required": [
    "name"
  ]
}
