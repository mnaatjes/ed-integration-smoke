{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/solidcompositions#",
  "title": "SpanshSolidCompositions",
  "description": "What the body is comprised of.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "description": "Name of the composition.",
        "type": "string",
        "enum": [
          "Ice",
          "Metal",
          "Rock"
        ]
      },
      "share": {
        "description": "Percentage of the composition that can be found.",
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "name",
      "share"
    ],
    "additionalProperties": false
  }
}
