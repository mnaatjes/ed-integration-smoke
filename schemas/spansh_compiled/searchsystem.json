{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spansh.co.uk/schemas/searchsystem#",
  "title": "SpanshSearchSystem",
  "description": "Spansh SearchSystem contract.",
  "type": "object",
  "properties": {
    "id64": {
      "description": "ID64 of the system, a 64 bit unsigned integer.",
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "description": "Name of the system.",
      "type": "string"
    },
    "x": {
      "description": "X coordinate of the system.",
      "type": "number"
    },
    "y": {
      "description": "Y coordinate of the system.",
      "type": "number"
    },
    "z": {
      "description": "Z coordinate of the system.",
      "type": "number"
    },
    "population": {
      "description": "Population of the system.",
      "type": "integer",
      "minimum": 0
    },
    "nearest_populated_distance": {
      "description": "Distance in LY to the nearest populated system.",
      "type": "number",
      "minimum": 0
    },
    "nearest_populated_id64": {
      "description": "ID64 of the nearest populated system, a 64 bit unsigned integer",
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "description": "The timestamp that the system was last updated, in UTC.",
      "type": "string",
      "format": "date-time"
    },
    "region": {
      "type": "string",
      "description": "Region the system lies within.",
      "$ref": "#/components/schemas/Region"
    },
    "government": {
      "description": "Government type of the system.",
      "$ref": "#/components/schemas/Government"
    },
    "allegiance": {
      "description": "Allegiance of the system.",
      "$ref": "#/components/schemas/Allegiance"
    },
    "state": {
      "description": "State of the system.",
      "$ref": "#/components/schemas/FactionState"
    },
    "security": {
      "description": "Security rating of the system.",
      "$ref": "#/components/schemas/Security"
    },
    "primary_economy": {
      "description": "Primary economy for the station.",
      "$ref": "#/components/schemas/Economy"
    },
    "secondary_economy": {
      "description": "Secondary economy for the station.",
      "$ref": "#/components/schemas/Economy"
    },
    "controlling_minor_faction": {
      "description": "Controlling faction of the system.",
      "type": "string",
      "nullable": true
    },
    "controlling_minor_faction_state": {
      "description": "State of the controlling faction of the system.",
      "$ref": "#/components/schemas/FactionState"
    },
    "is_colonised": {
      "description": "Is the system colonised?",
      "type": "boolean"
    },
    "is_being_colonised": {
      "description": "Is the system currently being colonised?",
      "type": "boolean"
    },
    "controlling_power": {
      "description": "Name of the controlling power of the system.",
      "$ref": "#/components/schemas/Power"
    },
    "power": {
      "description": "Power which controls the system.",
      "type": "array",
      "items": {
        "description": "Name of the powers.",
        "$ref": "#/components/schemas/Power"
      }
    },
    "power_state_control_progress": {
      "description": "Progress of the controlling power in controlling the system.",
      "type": "number"
    },
    "power_state_reinforcement": {
      "description": "Progress of the controlling power in reinforcing the system.",
      "type": "integer",
      "minimum": 0
    },
    "power_state_undermining": {
      "description": "Progress of the controlling power in losing the system.",
      "type": "integer",
      "minimum": 0
    },
    "needs_permit": {
      "description": "Does the system need a permit to enter?",
      "type": "boolean"
    },
    "known_permit": {
      "description": "Do we know where to get the permit for this system?",
      "type": "boolean"
    },
    "minor_faction_presences": {
      "description": "All minor factions with influence in the system.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of the faction.",
            "type": "string"
          },
          "allegiance": {
            "description": "Allegiance of the faction.",
            "$ref": "#/components/schemas/Allegiance"
          },
          "government": {
            "description": "Government type of the faction.",
            "$ref": "#/components/schemas/Government"
          },
          "state": {
            "description": "State of the faction.",
            "$ref": "#/components/schemas/FactionState"
          },
          "influence": {
            "$ref": "#/components/schemas/Influence"
          },
          "active_states": {
            "description": "Currently active states for this faction.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactionState"
            }
          },
          "pending_states": {
            "description": "Pending states for this faction.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactionState"
            }
          },
          "recovering_states": {
            "description": "Recovering states for this faction.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactionState"
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "power_conflict_progress": {
      "description": "Progress of any conflict between powers in the system.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "power": {
            "description": "Name of the power involved in the conflict.",
            "$ref": "#/components/schemas/Power"
          },
          "progress": {
            "description": "Progress of the power in the conflict.",
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "power",
          "progress"
        ],
        "additionalProperties": false
      }
    },
    "power_state": {
      "description": "State of the controlling power for this system.",
      "$ref": "#/components/schemas/PowerState"
    },
    "synthesis_recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/SynthesisRecipe"
          },
          "level": {
            "$ref": "#/components/schemas/SynthesisGrade"
          }
        },
        "required": [
          "name",
          "level"
        ],
        "additionalProperties": false
      }
    },
    "body_count": {
      "description": "Count of the number of bodies (planets and stars) that exist in the system.",
      "type": "integer",
      "minimum": 0
    },
    "bodies": {
      "description": "All bodies which have been scanned in the system.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The ID of the body, a 64 bit unsigned integer.",
            "type": "integer",
            "minimum": 0
          },
          "id64": {
            "description": "The ID64 of the body, a 64 bit unsigned integer.",
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "description": "The name of the body.",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/BodyType"
          },
          "subtype": {
            "$ref": "#/components/schemas/BodySubtype"
          },
          "terraforming_state": {
            "$ref": "#/components/schemas/BodyTerraformingState"
          },
          "is_main_star": {
            "description": "Stars only.  Whether this is the main star of the system or not.",
            "type": "boolean",
            "nullable": true
          },
          "distance_to_arrival": {
            "description": "Distance to the system arrival point of the body, measured in Kilometres.",
            "type": "number",
            "minimum": 0
          },
          "estimated_scan_value": {
            "description": "Estimated reward from scanning the body.",
            "type": "integer",
            "minimum": 0
          },
          "estimated_mapping_value": {
            "description": "Estimated reward from mapping the body.",
            "type": "integer",
            "minimum": 0
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/LandmarkType"
                },
                "subtype": {
                  "$ref": "#/components/schemas/LandmarkSubtype"
                },
                "count": {
                  "description": "Count of the number of instances of this landmark on the body.",
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "description": "Estimated reward from scanning the landmark.",
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "count",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "landmark_value": {
            "description": "Total value of all the landmarks on the body.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "id64",
          "name",
          "type",
          "is_main_star",
          "distance_to_arrival",
          "estimated_scan_value",
          "estimated_mapping_value"
        ],
        "additionalProperties": false
      }
    },
    "stations": {
      "description": "All stations which are known in the system.",
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/BriefSearchStation"
      }
    },
    "thargoid_war_state": {
      "description": "Current Thargoid state in this system.",
      "$ref": "#/components/schemas/ThargoidState"
    },
    "thargoid_war_failure_state": {
      "description": "Thargoid state in this system if the war is lost by the players.",
      "$ref": "#/components/schemas/ThargoidState"
    },
    "thargoid_war_success_state": {
      "description": "Thargoid state in this system if the war is won by the players.",
      "$ref": "#/components/schemas/ThargoidState"
    },
    "thargoid_war_success_reached": {
      "description": "Have the players won the Thargoid war in this system.",
      "type": "boolean"
    },
    "thargoid_war_progress": {
      "description": "Progress of the Thargoid war in this system.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "thargoid_war_days_remaining": {
      "description": "Days remaining of the Thargoid war in this system.",
      "type": "number",
      "minimum": 0
    },
    "thargoid_war_ports_remaining": {
      "description": "Posts remaining in the Thargoid war in this system.",
      "type": "number",
      "minimum": 0
    },
    "estimated_scan_value": {
      "description": "Estimated reward from scanning all the bodies in the system.",
      "type": "integer",
      "minimum": 0
    },
    "estimated_mapping_value": {
      "description": "Estimated reward from mapping all the bodies in the system.",
      "type": "integer",
      "minimum": 0
    },
    "landmark_value": {
      "description": "Total value of all the landmarks in the system.",
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id64",
    "name",
    "x",
    "y",
    "z",
    "population",
    "needs_permit",
    "known_permit"
  ]
}
